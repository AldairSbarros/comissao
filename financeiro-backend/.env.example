# Gere um valor com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# OCR dos recibos manuscritos. Sem chave, o upload funciona igual,
# mas sem o pre-preenchimento automatico dos campos.
# Provedor padrao: muse (Meta API, formato OpenAI-compatible).
MODEL_API_KEY=
# Opcionais do provedor muse:
# META_API_URL=https://api.meta.ai/v1
# OCR_MUSE_MODEL=muse-spark-1.3
# Provedor alternativo: gemini (Google AI Studio).
# OCR_PROVIDER=gemini
# GEMINI_API_KEY=
# OCR_GEMINI_MODEL=gemini-2.5-flash  # (default no codigo: gemini-2.0-flash)

# Evolution API (WhatsApp) — agradecimento com foto e recebimento de 1a via via webhook
# EVOLUTION_API_URL=https://evo.sua-igreja.com
# EVOLUTION_API_KEY=sua-apikey
# EVOLUTION_INSTANCE=nome-da-instancia
# Encaminha eventos ignorados pelo webhook de recibos (ex.: bot teologico AletheIA)
# EVOLUTION_FORWARD_WEBHOOK_URL=https://api.aletheia.ia.br/api/whatsapp/handle
